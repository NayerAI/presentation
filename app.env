# Runtime configuration for the presentations service (loaded by docker-compose).

# Port the app listens on inside the container / network.
PORT=8000

# Where all persistent data is stored inside the container. This is
# bind-mounted to ./data on the host (see docker-compose.yml), so copying
# ./data elsewhere is a complete backup.
DATA_DIR=/data

# Password for the admin dashboard (/admin). CHANGE THIS before deploying.
ADMIN_PASSWORD=changeme
